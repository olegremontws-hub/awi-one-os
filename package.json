{
  "name": "awi-one-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "start:project-service": "tsx services/project-service/src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test:client": "tsx --test tests/client-journey.test.ts",
    "qa:client:http": "tsx services/client-tester/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/pg": "^8.15.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/busboy": "^1.5.4"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "pdf-parse": "^1.1.1",
    "@aws-sdk/client-s3": "^3.896.0",
    "busboy": "^1.6.0"
  }
}
